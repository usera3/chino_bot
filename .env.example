# Chino Bot environment template.
# Copy this file to .env and fill only the values you need.
# Never commit .env, provider keys, QQ credentials, cookies, or private logs.

# Bot / OneBot
HOST=127.0.0.1
PORT=8080
BOT_QQ=your_bot_qq_number
SUPERUSERS=["your_admin_qq_number"]
NICKNAME=["智乃", "chino"]
COMMAND_START=["/", ""]
COMMAND_SEP=["."]
ONEBOT_ACCESS_TOKEN=

# Security boundaries
CHINO_PROJECT_ROOT=/absolute/path/to/chino_bot
CHINO_ADMIN_USERS=your_admin_qq_number
CHINO_LOG_DIR=/absolute/path/to/chino_bot/logs

# LLM provider: choose one.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENCLAW_GATEWAY_TOKEN=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

DASHSCOPE_API_KEY=

# Optional tools.
TAVILY_API_KEY=
AMAP_API_KEY=
PEXELS_API_KEY=

# Optional LangSmith tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=chino-bot
