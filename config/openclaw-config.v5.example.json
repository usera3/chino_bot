{
  "env": {
    "shellEnv": {
      "enabled": true,
      "timeoutMs": 15000
    }
  },
  "browser": {
    "enabled": true,
    "executablePath": ""
  },
  "models": {
    "mode": "merge",
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "${OPENAI_API_KEY}",
        "auth": "api-key",
        "api": "openai-responses",
        "authHeader": true,
        "models": [
          {
            "id": "gpt-5.5",
            "name": "GPT-5.5",
            "api": "openai-responses",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 1050000,
            "maxTokens": 128000
          },
          {
            "id": "gpt-5.2",
            "name": "GPT-5.2",
            "api": "openai-responses",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 400000,
            "maxTokens": 128000
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.5",
        "fallbacks": ["openai/gpt-5.2"]
      },
      "models": {
        "openai/gpt-5.5": {
          "alias": "gpt",
          "params": {
            "store": false
          }
        },
        "openai/gpt-5.2": {
          "params": {
            "store": false
          }
        }
      },
      "workspace": "/absolute/path/to/chino_bot/openclaw",
      "userTimezone": "Asia/Shanghai",
      "compaction": {
        "mode": "safeguard"
      }
    }
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": [
      "qq_group_files_list",
      "qq_group_file_info",
      "qq_group_file_url",
      "qq_group_file_download",
      "qq_group_file_upload",
      "qq_packet_status",
      "qq_user_info",
      "qq_group_members",
      "qq_send_like",
      "qq_send_poke",
      "qq_send_image",
      "qq_send_voice",
      "qq_send_mention",
      "qq_send_file",
      "qq_recall_message",
      "qq_make_meme",
      "qq_search_image",
      "tts",
      "qq_debug_inject_message",
      "qq_debug_replay",
      "send_email",
      "chinobot-bridge"
    ]
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "bridge-message-sent": {
          "enabled": true
        }
      }
    }
  },
  "channels": {
    "qq": {
      "enabled": true,
      "selfId": "YOUR_QQ_BOT_ID",
      "autoLaunch": false,
      "preventIdleSleep": false,
      "blockedUserIds": [],
      "naturalChat": {
        "enabled": true,
        "applyToGroups": true,
        "applyToDirect": true,
        "splitMessages": true,
        "removeDecorativeEmoji": true,
        "hardBannedSymbols": ["☕"],
        "defaultPersona": "chino",
        "allowPersonaSwitch": true
      },
      "studyMode": {
        "enabled": true,
        "directOnly": true,
        "autoSolveLikelyProblemImages": true,
        "alwaysRenderHtml": true,
        "answerStyle": "exam",
        "skills": [
          "qq-problem-solving",
          "qq-fusion-actions",
          "chinobot-capability-router",
          "qq-native"
        ]
      },
      "friendRequests": {
        "autoApproveEnabled": false,
        "minQqLevel": 16
      },
      "listenHost": "127.0.0.1",
      "listenPort": 8080,
      "websocketPath": "/onebot/v11/ws",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "plugins": {
    "entries": {
      "qq": {
        "enabled": false
      },
      "qq-natural": {
        "enabled": true,
        "config": {
          "voiceSynthesis": {
            "enabled": false,
            "projectRoot": "/absolute/path/to/chino_bot/voice/qwen3-tts-apple-silicon",
            "pythonPath": "python3",
            "scriptPath": "/absolute/path/to/chino_bot/voice/qwen3-tts-apple-silicon/openclaw_clone_tts.py",
            "modelPath": "/absolute/path/to/chino_bot/voice/qwen3-tts-apple-silicon/models/Qwen3-TTS-12Hz-1.7B-Base-8bit",
            "voiceName": "akari2",
            "timeoutMs": 120000,
            "fallbackToSystemSay": true
          }
        }
      },
      "chinobot-bridge": {
        "enabled": true,
        "config": {
          "projectRoot": "/absolute/path/to/chino_bot",
          "bridgeScript": "/absolute/path/to/chino_bot/bridge/openclaw_tool_bridge.py",
          "pythonPath": "/absolute/path/to/chino_bot/.venv/bin/python",
          "timeoutMs": 30000,
          "voiceSynthesis": {
            "enabled": false,
            "projectRoot": "/absolute/path/to/chino_bot/voice/qwen3-tts-apple-silicon",
            "pythonPath": "python3",
            "scriptPath": "/absolute/path/to/chino_bot/voice/qwen3-tts-apple-silicon/openclaw_clone_tts.py",
            "modelPath": "/absolute/path/to/chino_bot/voice/qwen3-tts-apple-silicon/models/Qwen3-TTS-12Hz-1.7B-Base-8bit",
            "voiceName": "akari2",
            "timeoutMs": 120000,
            "fallbackToSystemSay": true
          }
        }
      }
    }
  }
}
